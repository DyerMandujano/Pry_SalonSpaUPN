@model IEnumerable<Pry_Solu_SalonSPA.Models.Cita>

<link href="~/css/VCitas/_ListaCitas.css" rel="stylesheet" />

<div class="contenedor-citas">

    <div class="fila-cita encabezado">
        <div>ID</div>
        <div>Cliente</div>
        <div>Servicio</div>
        <div>Empleado</div>
        <div>Fecha</div>
        <div>Hora</div>
        <div>Precio</div>
        <div>Estado</div>
        <div>Acciones</div>
    </div>

    @foreach (var cita in Model)
    {
        var cliente = cita.IdClienteNavigation?.IdPersonaNavigation;
        var empleadoPersona = cita.IdEmpleadoHorarioNavigation?.IdEmpleadoNavigation?.IdPersonaNavigation;

        foreach (var cs in cita.CitaServicios)
        {
            <div class="fila-cita">
                <div class="celda" data-label="Id">
                    @cita.IdCita
                </div>

                <div class="celda" data-label="Cliente">
                    @(cliente != null ? $"{cliente.Nombres} {cliente.Apellidos}" : "Sin cliente")
                </div>

                <div class="celda" data-label="Servicio">
                    @cs.IdServicioNavigation?.Nombre
                </div>

                <div class="celda" data-label="Empleado">
                    @(empleadoPersona != null ? $"{empleadoPersona.Nombres} {empleadoPersona.Apellidos}" : "Sin empleado")
                </div>

                <div class="celda" data-label="Fecha">
                    @cita.FechaCita.ToString("dd/MM/yyyy")
                </div>

                <div class="celda" data-label="Hora">
                    @cita.FechaCita.ToString("HH:mm")
                </div>

                <div class="celda" data-label="Precio">
                    @cs.IdServicioNavigation?.Precio.ToString("C")
                </div>

                <div class="celda" data-label="Estado">
                    @{
                        string estadoTexto = cs.Estado == 1 ? "Completado" :
                        cs.Estado == 2 ? "Pendiente" :
                        cs.Estado == 3 ? "Reprogramado" :
                        cs.Estado == 4 ? "Cancelada" : "Desconocido";

                        string color = cs.Estado == 1 ? "success" :
                        cs.Estado == 2 ? "warning" :
                        cs.Estado == 3 ? "info" :
                        cs.Estado == 4 ? "danger" : "secondary";
                    }
                    <span class="badge @color">@estadoTexto</span>
                </div>

                <div class="celda acciones" data-label="Acciones">
                    <a href="javascript:void(0);"
                       onclick="document.getElementById('detalle-@cita.IdCita').classList.toggle('mostrar');"
                       class="btn-accion detalles">
                        <i class="bi bi-eye"></i>
                    </a>

                    <a asp-action="Editar"
                       asp-route-id="@cita.IdCita"
                       class="btn-accion editar">
                        <i class="bi bi-pencil"></i>
                    </a>

                    <form asp-action="Eliminar" method="post" style="display:inline">
                        <input type="hidden" name="id" value="@cita.IdCita" />
                        <button type="submit" class="btn-accion eliminar">
                            <i class="bi bi-trash"></i>
                        </button>
                    </form>
                </div>
            </div>

            <div id="detalle-@cita.IdCita" class="detalle-observacion">
                <button type="button" class="btn-cerrar-detalle"
                        onclick="document.getElementById('detalle-@cita.IdCita').classList.remove('mostrar');">
                    &times;
                </button>
                <strong>Observaciones del servicio:</strong>
                <ul>
                    @foreach (var csd in cita.CitaServicios)
                    {
                        <li>@(string.IsNullOrWhiteSpace(csd.Observacion) ? "Sin observaciones" : csd.Observacion)</li>
                    }
                </ul>
            </div>
        }
    }
</div>

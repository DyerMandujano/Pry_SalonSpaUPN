@model IEnumerable<Pry_Solu_SalonSPA.Models.Proveedor>

<table class="table table-striped table-bordered tabla-proveedores">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>RUC</th>
            <th>Correo</th>
            <th>Teléfono</th>
            <th>Tipo proveedor</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.NomProve</td>
                    <td>@item.Ruc</td>
                    <td>@item.Correo</td>
                    <td>@item.Telefono</td>
                    <td>@(item.TipoProveedor ?? string.Empty)</td>
                    <td>@(item.Estado == 1 ? "Activo" : "Inactivo")</td>
                    <td>
                        <a asp-action="Editar" asp-route-id="@item.IdProveedor" class="btn btn-sm btn-warning">Editar</a>

                        <form asp-action="CambiarEstado" method="post" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@item.IdProveedor" />
                            <button type="submit" class="btn btn-sm @(item.Estado == 1 ? "btn-danger" : "btn-success")">
                                @(item.Estado == 1 ? "Desactivar" : "Activar")
                            </button>
                        </form>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="7" class="text-center">No se encontraron proveedores registrados.</td>
            </tr>
        }
    </tbody>
</table>
@model Pry_Solu_SalonSPA.Models.Proveedor

@{
    Layout = "~/Views/Main.cshtml";
    ViewData["Title"] = "Crear Proveedor";
}

<h2>Crear Proveedor</h2>

<form asp-action="Crear" method="post" class="mt-3">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-group mb-2">
        <label asp-for="NomProve" class="form-label">Nombre</label>
        <input asp-for="NomProve" class="form-control" />
        <span asp-validation-for="NomProve" class="text-danger"></span>
    </div>

    <div class="form-group mb-2">
        <label asp-for="Ruc" class="form-label">RUC</label>
        <input asp-for="Ruc" class="form-control" />
        <span asp-validation-for="Ruc" class="text-danger"></span>
    </div>

    <div class="form-group mb-2">
        <label asp-for="Correo" class="form-label">Correo</label>
        <input asp-for="Correo" class="form-control" />
        <span asp-validation-for="Correo" class="text-danger"></span>
    </div>

    <div class="form-group mb-2">
        <label asp-for="Telefono" class="form-label">Teléfono</label>
        <input asp-for="Telefono" class="form-control" />
        <span asp-validation-for="Telefono" class="text-danger"></span>
    </div>

    <div class="form-group mb-2">
        <label asp-for="TipoProveedor" class="form-label">Tipo proveedor</label>
        <input asp-for="TipoProveedor" class="form-control" />
        <span asp-validation-for="TipoProveedor" class="text-danger"></span>
    </div>

    <div class="form-group mb-2">
        <label asp-for="Estado" class="form-label">Estado</label>
        <select asp-for="Estado" class="form-control" asp-items="(SelectList)ViewBag.Estados"></select>
        <span asp-validation-for="Estado" class="text-danger"></span>
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-success">Guardar</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </div>
</form>
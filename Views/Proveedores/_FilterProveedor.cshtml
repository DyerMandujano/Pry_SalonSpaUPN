@{
    var busqueda = ViewBag.Busqueda ?? "";
}

<form method="get" asp-action="Index" class="form-inline mb-3">
    <input type="text" name="busqueda" value="@busqueda" class="form-control mr-2" placeholder="Buscar por nombre o RUC" />

    <select name="estado" class="form-control mr-2" asp-items="(SelectList)ViewBag.Estados"></select>

    <button type="submit" class="btn btn-primary">Buscar / Filtrar</button>
    <a asp-action="Index" class="btn btn-outline-secondary ml-2">Limpiar</a>
</form>